{:uriI"Ûfile:///home/shashwatkathuria/Desktop/Coding%20Related%20Stuff/SocialCloud/app/assets/javascripts/social-cloud/user-show-profile/user-show-profile.template.html?type=text/html&id=ee8bc7ef9858886978097e64881a252b4ec87283bdad735fa159330fa8076ba1:ET:load_pathI"app/assets/javascripts;T:filenameI"Zapp/assets/javascripts/social-cloud/user-show-profile/user-show-profile.template.html;T:	nameI">social-cloud/user-show-profile/user-show-profile.template;T:logical_pathI"Csocial-cloud/user-show-profile/user-show-profile.template.html;T:content_typeI"text/html;T:sourceI"{<div class="well well-lg" >
      <h2><span class="glyphicon glyphicon-picture" aria-hidden="true"></span> {{ $ctrl.userProfile.user.first_name + " " + $ctrl.userProfile.user.last_name }}</h2>
      <hr>
      <h2><small>@{{ $ctrl.userProfile.user.username }}</small></h2>
      <br>
      <a ng-if="$ctrl.userProfile.link" ng-href="{{ $ctrl.userProfile.link }}" class="btn transparentButton btn-default center-block" style="margin-top:8px;margin-bottom:8px;" role="button">{{ $ctrl.userProfile.link.includes('unfollow') ? 'Unfollow' : 'Follow'}}</a>
      <p ng-if="$ctrl.userProfile.posts.length == 0" style="text-align:center;" ><br>@{{ $ctrl.userProfile.user.username }} has no posts yet!</p>
</div>

<div class="row" ng-repeat="post in $ctrl.userProfile.posts">
  <div class="col-sm-12 col-md-12 col-lg-12">
    <div class="thumbnail">
      <div class="caption">
          <h3><span style="color:orange;"><span class="glyphicon glyphicon-picture" aria-hidden="true"></span> {{ post.image_heading }}</span><hr> {{ post.image_caption }}</h3>
          <p><a ng-href="#" class="btn btn-default disabledTransparentButton disabled"  role="button"><span class="glyphicon glyphicon-time" aria-hidden="true"></span> Posted {{ post.time }} ago</a>
      </div>
      <img ng-src="data:{{ post.image_content_type }};base64,{{ post.image_base64 }}" alt="{{ post.image_caption }}">
    </div>
  </div>
</div>
